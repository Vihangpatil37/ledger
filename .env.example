# MongoDB Atlas (Settings → Database → Connect → Drivers):
#   MONGODB_URI    = connection string — URL-encode the password
#   MONGODB_DB     = database name (defaults to "ledger")
#   SESSION_SECRET = random string used to sign session cookies, e.g.:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONGODB_URI=
MONGODB_DB=ledger
SESSION_SECRET=
